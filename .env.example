# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these as project environment variables instead
# — see the "Deploying" section in README.md for where each one comes from.

# Plain Postgres connection string. If you're using Vercel's "Prisma
# Postgres" product, use its POSTGRES_URL value here (NOT its DATABASE_URL
# or PRISMA_DATABASE_URL — those are prisma+postgres:// Accelerate URLs for
# a Prisma Client setup this app doesn't use). If you're on plain Neon or
# another Postgres host instead, its standard connection string works too.
POSTGRES_URL="postgresql://user:password@host/db?sslmode=require"

# Password required to unlock the internal/admin view (add, edit, delete,
# mark sold, manage patterns & colors, see internal metadata).
ADMIN_PASSWORD="change-me"

# Random string used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-too"

# Anthropic API key, used to auto-guess a new product's name/category/
# pattern/colors from its photos when uploading. Optional: if unset, the
# upload form still works, just without AI suggestions.
ANTHROPIC_API_KEY=""

# Vercel Blob storage token, used to store uploaded product photos in
# production (the app's local filesystem isn't persistent on Vercel).
# Leave blank for local dev — uploads then fall back to public/uploads on
# disk. Vercel sets this automatically once you connect a Blob store to the
# project; you don't need to create it by hand except to test Blob locally.
BLOB_READ_WRITE_TOKEN=""

# Resend API key, used to email you when a visitor submits a request. Get
# one free at resend.com -> API Keys. Optional: if unset, requests still
# save normally, you just won't get an email notification.
RESEND_API_KEY=""

# Where request notification emails are sent -- almost always your own
# email address. Required for request-notification emails to send.
ADMIN_NOTIFICATION_EMAIL=""

# The "from" address on request notification emails. Optional: leave unset
# to send from Resend's shared sandbox address, which works fine for
# notifying yourself without verifying a domain in Resend.
RESEND_FROM_EMAIL=""
